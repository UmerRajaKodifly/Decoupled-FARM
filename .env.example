# Copy to .env and fill in. Do not commit .env.

# Shared Bearer token for both vLLM ports (8100 caption, 8102 embed).
# Clients send: Authorization: Bearer <VLLM_API_KEY>
VLLM_API_KEY=replace-with-a-long-random-token

# Hugging Face token if the VL / embedding repos are gated.
HF_TOKEN=

# Client URL host (Pakistan uses this NetBird IP in VLLM_BASE_URL).
VLLM_HOST=100.109.254.4
# vLLM listen bind (0.0.0.0 + UFW/iptables on wt0).
VLLM_BIND_HOST=0.0.0.0
# This HK box already uses 8000/8002 for other services. Pakistan must point at these ports.
VLLM_VLM_PORT=8100
VLLM_EMBED_PORT=8102
